# Auto detect text files and normalize line endings to LF
* text=auto

# Python
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf
*.pyo text eol=lf

# Shell
*.sh text eol=lf
*.bash text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text diff=markdown
*.txt text diff=plain

# Media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# JSON/YAML
*.json text
*.yml text
*.yaml text
